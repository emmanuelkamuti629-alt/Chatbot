# OpenAI Configuration
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=500
OPENAI_TEMPERATURE=0.7

# Bot Configuration
BOT_NAME=Smart Assistant
BOT_PERSONALITY=You are a helpful, accurate, and friendly assistant. Answer questions clearly and concisely. If you don't know something, say so honestly. Never make up facts.
MAX_HISTORY_MESSAGES=10

# Server Configuration (optional webhook mode)
PORT=3000
WEBHOOK_URL=

# WhatsApp Session
SESSION_PATH=./.wwebjs_auth
CACHE_PATH=./.wwebjs_cache

# Logging
LOG_LEVEL=info
